let dia = Number(prompt("Digite um número entre 1 a 7 do dia semana:"));

switch (dia){
    case 1:
        console.log("Domingo");
        break;
    case 2:
        console.log("Segunda");
        break;
    case 3:
        console.log("Terça");
        break;
        
    case 4:
        console.log("Quarta");
        break;

    case 5:
        console.log("Quinta");
        break;

    case 6:
        console.log("Sexta");
        break;

    case 7:
        console.log("Sabado");
        break;
    
    default:
        console.log("Digite um número entre 1 a 7");

       

}
