<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1> calcular média </h1>
  <input type="number" id="nota1" placeholder="Digite primeira nota">
  <input type="number" id="nota2" placeholder="Digite segunda nota">
  <input type="number" id="nota3" placeholder="Digite terceira nota">
  <button onclick="calcularMedia()"> Enviar</button> 
  <p id="resultado"></p>

  <script>
    function calcularMedia(){
      let n1 = Number(document.getElementById("nota1").value);
      let n2 = Number(document.getElementById("nota2").value);
      let n3 = Number(document.getElementById("nota3").value);

      let notas = [n1, n2, n3];
      let soma = 0;

      for (let nota of notas) {
        soma = soma + nota;
      }

      let media = soma / notas.length;
      let mensagem = "Média: " + media.toFixed(2);

      if (media >= 6) {
        mensagem += " - Aluno aprovado";
      } else {
        mensagem += " - Aluno reprovado";
      }

      document.getElementById("resultado").textContent = mensagem;
    }
  </script>

  </body>
</html>


