let alunos = ["Matias","Alvani","Daniel","Luana","Mauricio"]; // como é feito o array 

console.log(alunos); //trazer todos

console.log(alunos[3]); //trazer especifico 

alunos.push("Gabriel"); //acescenta o ultimo item 
console.log(alunos);

alunos.pop(); //retira o ultimo
console.log(alunos); 

alunos.shift(); //remove o primeiro
console.log(alunos);

alunos.unshift("Gabriela"); // acrescenta no primeiro
console.log(alunos);


alunos.splice(1,2); //remove 2 a partir de acordo com a posiçao e quantidade
console.log(alunos);

let posicao = alunos.indexOf("Mauricio"); //encontrar a posicao
console.log(posicao);

